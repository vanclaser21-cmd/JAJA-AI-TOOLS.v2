  "personalities": [
    {
      "name": "tech reviewer",
      "dialogues": [
        "Aku tes {{product_name}} dari hal yang paling kepakai dulu.",
        "Detail kecil ini ternyata ngaruh banget.",
        "Buat pemakaian harian, ini terasa masuk akal."
      ]
    },
    {
      "name": "curious tester",
      "dialogues": [
        "Aku penasaran, {{product_name}} ini beneran sepraktis itu nggak?",
        "Jadi aku coba langsung tanpa banyak teori.",
        "Ternyata ada detail yang nggak kelihatan di foto."
      ]
    },
    {
      "name": "comparison style",
      "dialogues": [
        "Aku bandingin {{product_name}} sama yang biasa aku pakai.",
        "Bedanya paling terasa di bagian ini.",
        "Sekarang aku ngerti kenapa orang pilih ini."
      ]
    },
    {
      "name": "problem solver",
      "dialogues": [
        "Aku cari yang bisa bikin proses ini lebih gampang.",
        "Jadi aku coba {{product_name}} di situasi nyata.",
        "Buat kebutuhanku, detail ini yang paling membantu."
      ]
    },
    {
      "name": "expert style",
      "dialogues": [
        "Aku lihat dulu desain dan fungsi {{product_name}}.",
        "Bagian ini yang menurutku paling worth diperhatiin.",
        "Buat kebutuhan tertentu, pilihannya cukup solid."
      ]
    }
  ],
