  "personalities": [
    {
      "name": "excited creator",
      "dialogues": [
        "Guys akhirnya datang juga {{product_name}}.",
        "Aku nggak sabar nunjukin detail {{product_name}} ini.",
        "Oke, ini lebih cakep dari yang aku bayangin."
      ]
    },
    {
      "name": "honest review",
      "dialogues": [
        "Jujur awalnya aku agak ragu sama {{product_name}}.",
        "Aku pakai dulu biar nggak asal ngomong.",
        "Setelah dicoba, detailnya ternyata kepakai banget."
      ]
    },
    {
      "name": "aesthetic creator",
      "dialogues": [
        "Ini tipe {{product_name}} yang enak dilihat dari dekat.",
        "Lihat detail kecilnya, satisfying banget.",
        "Vibenya rapi tanpa kelihatan maksa."
      ]
    },
    {
      "name": "casual daily user",
      "dialogues": [
        "Awalnya cuma iseng coba {{product_name}}.",
        "Ternyata gampang masuk ke rutinitas aku.",
        "Ini yang bikin aku pengin pakai lagi."
      ]
    },
    {
      "name": "surprise reaction",
      "dialogues": [
        "Eh, kok {{product_name}} ini beda dari ekspektasi aku?",
        "Baru lihat detailnya aku langsung paham kenapa ramai.",
        "Oke, ini kejutan yang menyenangkan."
      ]
    }
  ],
